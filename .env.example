# STRATA ContentVault — Environment Configuration Template (Mission 005)
# Copy to .env for local configuration (NEVER commit .env or secret files to Git).

# Runtime mode: development | production
NODE_ENV=development

# Network binding (use 127.0.0.1 for local desktop, 0.0.0.0 inside containers)
HOST=127.0.0.1
PORT=7410

# ----------------------------------------------------------------------------
# Signing Secrets & Bounded Key Rotation (SEC-002 / AUD-D3)
# ----------------------------------------------------------------------------
# Production secrets MUST be generated by a cryptographic CSPRNG (`openssl rand -hex 48`
# or `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
# Secret files MUST have mode 0600 or 0400 in production.
CV_SIGNING_SECRET=
CV_SIGNING_SECRET_FILE=

# Optional zero-downtime key rotation (max 24h overlap enforced in production via ISO-8601 expiry):
CV_SIGNING_SECRET_PREVIOUS=
CV_SIGNING_SECRET_PREVIOUS_FILE=
CV_SIGNING_SECRET_PREVIOUS_EXPIRES_AT=

# ----------------------------------------------------------------------------
# Database Backend & PostgreSQL 16 Least-Privilege Runtime (AUD-C1, AUD-C2, AUD-D3)
# ----------------------------------------------------------------------------
# Backend: sqlite (local zero-paid-infra dev) | postgres (production multi-replica RLS)
# Production NEVER silently falls back from PostgreSQL to SQLite.
CV_DB_BACKEND=sqlite
CV_REQUIRE_POSTGRES=0
CV_ENFORCE_DB_ROLE_SEPARATION=1

# Runtime connection MUST use restricted `cv_runtime` login (NOSUPERUSER, NOBYPASSRLS, non-owner):
DATABASE_URL=
# Privileged owner connection used ONLY for `npm run migrate:pg` / `restore-pg`:
DATABASE_MIGRATION_URL=
CV_PG_RUNTIME_PASSWORD=

# PostgreSQL TLS mode: disable (local dev) | require | verify-ca | verify-full
CV_PG_SSL_MODE=disable
CV_PG_SSL_CA_FILE=
CV_PG_POOL_MAX=12
CV_PG_CONNECT_TIMEOUT_MS=5000

# Private runtime directory (`0700` enforced on dir, `0600` on SQLite files)
CV_DATA_DIR=

# ----------------------------------------------------------------------------
# Session & Signed Token Lifetimes (SEC-002 / SEC-005)
# ----------------------------------------------------------------------------
CV_SESSION_IDLE_MINUTES=120
CV_SESSION_MAX_HOURS=12
CV_PAGE_TOKEN_TTL=45
CV_AUDIO_TOKEN_TTL=60

# ----------------------------------------------------------------------------
# Attack-Resistant Rate Limiting & Scrypt Backpressure (AUD-C4, AUD-D1, AUD-D2)
# ----------------------------------------------------------------------------
CV_RATE_LIMIT_MAX_BUCKETS=10000
CV_LOGIN_IP_LIMIT=25
CV_LOGIN_PAIR_FAIL_LIMIT=5
CV_LOGIN_ACCOUNT_FAIL_LIMIT=8
CV_LOGIN_GLOBAL_FAIL_BUDGET=30
CV_LOGIN_CLEAN_IP_VERIFY_CEILING=120
CV_LOGIN_MAX_CONCURRENT_SCRYPT=8
CV_LOGIN_MAX_SCRYPT_QUEUE=32
CV_LOGIN_ACCOUNT_WINDOW_SECONDS=300

# Trusted reverse-proxy list (comma-separated IPv4/IPv6 IPs or CIDRs, e.g. 127.0.0.1,10.0.0.0/8,fd00::/8).
# Empty by default: X-Forwarded-* headers are ignored unless TCP peer matches CV_TRUST_PROXY.
CV_TRUST_PROXY=

# ----------------------------------------------------------------------------
# Bounded PDF Worker Pool & Render Cache Limits (AUD-A1, AUD-A2)
# ----------------------------------------------------------------------------
CV_PDF_ENGINE=pypdfium2
CV_RENDER_DPI=144
CV_WORKER_MAX_CONCURRENCY=4
CV_WORKER_MAX_QUEUE=24
CV_WORKER_MAX_PER_USER=2
CV_WORKER_TIMEOUT_MS=20000
CV_WORKER_KILL_GRACE_MS=500
CV_RENDER_CACHE_MAX_BYTES=134217728
CV_RENDER_CACHE_TTL_MS=86400000
CV_MIN_FREE_DISK_BYTES=33554432
CV_WATERMARK_FONT_PATH=
CV_PYTHON=

# ----------------------------------------------------------------------------
# Local Evaluation Flags (Strictly forbidden when NODE_ENV=production)
# ----------------------------------------------------------------------------
CV_ENABLE_DEMO_PERSONAS=0
CV_DEMO_ADMIN_PASSWORD=strata-demo-admin-local
CV_DEMO_STUDENT_PASSWORD=strata-demo-student-local
CV_ALLOW_FRAME_EMBED=0
