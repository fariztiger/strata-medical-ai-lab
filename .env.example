# STRATA ContentVault v0.1 — Environment Configuration Template
# Copy to .env for custom local settings. NEVER commit .env or real secrets to Git.

# HTTP Server Binding
PORT=7410
HOST=127.0.0.1
NODE_ENV=development

# Private Runtime Data Directory (SQLite DB, private object store, base raster cache)
# Defaults to <repo>/var when omitted.
# CV_DATA_DIR=/path/to/private/var

# Cryptographic Signing Secret (REQUIRED >= 32 chars when NODE_ENV=production)
# In local development, if unset, a 96-hex-char secret is generated at var/.dev-signing-secret (0600).
# CV_SIGNING_SECRET=replace-with-at-least-32-random-characters-in-production

# Session & Short-Lived Token Lifetimes
CV_SESSION_IDLE_MINUTES=120
CV_PAGE_TOKEN_TTL=45
CV_AUDIO_TOKEN_TTL=60

# Server-Side PDF Rasterisation DPI
CV_RENDER_DPI=144

# Optional Explicit Python Interpreter Path (defaults to .venv/bin/python or .venv/Scripts/python.exe)
# CV_PYTHON=/path/to/python

# Optional Local Seed Passphrases (for non-production synthetic demo bootstrap only)
# CV_DEMO_ADMIN_PASSWORD=strata-demo-admin-local
# CV_DEMO_STUDENT_PASSWORD=strata-demo-student-local
