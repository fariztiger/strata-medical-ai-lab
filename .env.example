# STRATA ContentVault v0.1 — Environment Configuration Template
# Copy to .env (never commit .env to Git).

# Runtime mode: development | production
NODE_ENV=development

# Network binding (use 127.0.0.1 for local desktop, 0.0.0.0 inside containers)
HOST=127.0.0.1
PORT=7410

# Mandatory in production (>= 32 random characters).
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CV_SIGNING_SECRET=

# Private runtime directory for SQLite database, encrypted/private objects, and base cache
# Defaults to <repo>/var
CV_DATA_DIR=

# Session & token lifetimes (SEC-002 / SEC-005)
CV_SESSION_IDLE_MINUTES=120
CV_SESSION_MAX_HOURS=12
CV_PAGE_TOKEN_TTL=45
CV_AUDIO_TOKEN_TTL=60

# Login rate-limiting & account lockout parameters (SEC-003)
CV_LOGIN_IP_LIMIT=25
CV_LOGIN_ACCOUNT_FAIL_LIMIT=8
CV_LOGIN_ACCOUNT_WINDOW_SECONDS=300

# Trusted reverse-proxy list (comma-separated IPs or IPv4 CIDRs, e.g., 127.0.0.1,10.0.0.0/8).
# Empty by default: X-Forwarded-* headers are NEVER trusted unless peer matches CV_TRUST_PROXY.
CV_TRUST_PROXY=

# Server-side rasterisation DPI (default 144) and optional custom TrueType/OpenType CJK font path
CV_RENDER_DPI=144
CV_WATERMARK_FONT_PATH=

# Optional explicit Python interpreter path (auto-detects <repo>/.venv/bin/python)
CV_PYTHON=

# Local synthetic evaluation persona directory & quick-switch (DISABLED by default; forbidden in production)
CV_ENABLE_DEMO_PERSONAS=0
CV_DEMO_ADMIN_PASSWORD=strata-demo-admin-local
CV_DEMO_STUDENT_PASSWORD=strata-demo-student-local

# Set to 1 ONLY in sandboxed local preview iframes (strictly rejected when NODE_ENV=production)
CV_ALLOW_FRAME_EMBED=0
