{
  "name": "@strata/contentvault-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STRATA ContentVault API & Web Reader - protected document access with server-side watermarking",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "setup": "bash ../../scripts/setup/install-python-deps.sh",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "check:db": "node scripts/check-db.js",
    "migrate:pg": "node scripts/migrate-pg.js up",
    "rollback:pg": "node scripts/migrate-pg.js down",
    "test": "node --test tests/*.test.js",
    "test:acceptance": "node tests/acceptance.test.js",
    "test:postgres": "node --test tests/phase-005-postgres-app.test.js tests/phase-005-db-privileges.test.js",
    "test:ratelimit": "node --test tests/phase-005-ratelimit.test.js",
    "test:worker": "node --test tests/phase-005-worker-resources.test.js",
    "test:backup": "node --test tests/phase-005-backup-ops.test.js",
    "test:browser": "node ../../scripts/verification/playwright-e2e.mjs"
  },
  "dependencies": {
    "pg": "8.13.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17"
  }
}
